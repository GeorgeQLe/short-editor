{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "jsx": "react-jsx"
  },
  "include": ["src/core/**/*.ts", "src/shared/**/*.ts", "src/security/**/*.ts", "src/electron/**/*.ts", "src/electron/**/*.cts", "src/mcp/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
