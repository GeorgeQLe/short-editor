{
  "name": "short-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Windows-first AI-assisted YouTube Shorts editor",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "npm run build && concurrently -k \"vite\" \"tsx watch src/core/cli.ts\" \"wait-on tcp:5173 tcp:43120 && electron .\"",
    "dev:core": "tsx watch src/core/cli.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.node.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "start:core": "node dist/core/cli.js",
    "start:mcp": "node dist/mcp/server.js",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.2.0",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "overrides": {
    "@hono/node-server": "^2.0.12"
  },
  "build": {
    "appId": "com.lexcorp.shorteditor",
    "productName": "Short Editor",
    "asarUnpack": [
      "**/*.node",
      "resources/bin/**"
    ],
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
